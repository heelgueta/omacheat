#!/bin/bash
# Omacheat: persist which keybindings are switched off, and apply that to Hyprland.
#
#   omacheat-apply list                 print the switched-off bindings as JSON
#   omacheat-apply set off|on <json>    switch bindings off/on; <json> = [{"mods":[..],"key":"..","desc":".."}]
#   omacheat-apply settings | setting <key> <true|false>   UI preferences (closeOnUse)
#   omacheat-apply custom               print the added shortcuts as JSON
#   omacheat-apply add|remove <json>    add / remove a shortcut: {"mods":[..],"key":"..","desc":"..","cmd":"..","category":".."}
#   omacheat-apply watch on|off         tell the Hyprland key listener whether the window is open
#   omacheat-apply apply                regenerate the lua file and reload Hyprland
#
# State:     ~/.config/omarchy/omacheat-disabled.json, omacheat-custom.json
# Generated: ~/.config/hypr/omacheat-disabled.lua  (loaded from hypr/bindings.lua)
#            holds the unbinds, the added shortcuts and the key listener behind "close after use"

state="${OMACHEAT_STATE:-$HOME/.config/omarchy/omacheat-disabled.json}"
custom="${OMACHEAT_CUSTOM:-$HOME/.config/omarchy/omacheat-custom.json}"
settings="${OMACHEAT_SETTINGS:-$HOME/.config/omarchy/omacheat-settings.json}"
generated="${OMACHEAT_GENERATED:-$HOME/.config/hypr/omacheat-disabled.lua}"
watch_flag="${XDG_RUNTIME_DIR:-/tmp}/omacheat-watch"

[[ -s $state ]] || echo '[]' >"$state"
# Changes that regenerate the lua file and reload Hyprland run detached and one at a time, so closing
# the window (which unloads the plugin and kills its child processes) can't leave a half-written file.
case "$1" in set|add|remove|apply)
  if [[ -z ${OMACHEAT_FOREGROUND:-} ]]; then
    exec setsid -f flock "${XDG_RUNTIME_DIR:-/tmp}/omacheat-apply.lock" env OMACHEAT_FOREGROUND=1 "$0" "$@"
  fi ;;
esac

[[ -s $custom ]] || echo '[]' >"$custom"
[[ -s $settings ]] || echo '{"closeOnUse":true}' >"$settings"

id_filter='def id: ((.mods | map(ascii_upcase) | sort | join(" ")) + "|" + .desc);'

# Prints "<raw keys>\t<description>" for every described bind in the user's Hyprland config.
scan_binds() {
  lua <<'LUA'
local noop
noop = setmetatable({}, { __index = function() return noop end, __call = function() return noop end })
-- hl.dsp.* must return plain tables: Omarchy's helpers inspect fields like value.omarchy.
local function dsp(path)
  return setmetatable({}, {
    __index = function(_, key) return dsp(path .. "." .. tostring(key)) end,
    __call = function() return {} end,
  })
end
hl = setmetatable({
  dsp = dsp("hl.dsp"),
  bind = function(keys, _, opts)
    if opts and opts.description and opts.description ~= "" then
      print(tostring(keys) .. "\t" .. opts.description)
    end
    return noop
  end,
  get_config = function() return nil end,
}, { __index = function() return noop end })
local file = io.open(os.getenv("HOME") .. "/.config/hypr/hyprland.lua", "r")
if file then file:close(); local ok, err = pcall(dofile, os.getenv("HOME") .. "/.config/hypr/hyprland.lua"); if not ok then io.stderr:write(tostring(err) .. "\n") end end
LUA
}

generate() {
  local scan
  scan=$(scan_binds)

  {
    echo "-- Generated by the Omacheat plugin (heelgueta.omacheat). Do not edit; use the Omacheat window."
    # Raw keys of every scanned bind whose "mods|description" id is switched off (one awk pass).
    awk -F'\t' '
      NR == FNR { want[$0] = 1; next }
      $1 != "" {
        k = split($1, p, / \+ /); m = k - 1; split("", a)
        for (i = 1; i <= m; i++) { x = toupper(p[i]); a[i] = (x == "CONTROL") ? "CTRL" : x }
        for (i = 2; i <= m; i++) { v = a[i]; j = i - 1; while (j > 0 && a[j] > v) { a[j + 1] = a[j]; j-- } a[j + 1] = v }
        id = ""; for (i = 1; i <= m; i++) id = id (i > 1 ? " " : "") a[i]
        if ((id "|" $2) in want) { raw = $1; gsub(/\\/, "\\\\", raw); gsub(/"/, "\\\"", raw); print "hl.unbind(\"" raw "\")" }
      }' <(jq -r "$id_filter .[] | id" "$state") <(printf '%s\n' "$scan") | sort -u

    # Added shortcuts. Control characters are dropped so every string is a valid Lua literal.
    jq -r 'def clean: gsub("[\\x00-\\x1f]"; "") | @json;
           .[] | ((.mods | map(ascii_upcase) | join(" + ")) + (if (.mods | length) > 0 then " + " else "" end) + .key) as $k
           | "hl.unbind(\($k | clean))\no.bind(\($k | clean), \(.desc | clean), o.launch(\"sh -c \" .. o.shell_quote(\(.cmd | clean))))"' "$custom"

    cat <<'LUA'

-- "Close after using a shortcut": while the Omacheat window is open it sets a flag file;
-- we then report the scancode of the latest non-modifier key press, so the window can tell
-- a key it received itself (typing, or an unbound combo) from one the compositor swallowed
-- because it completed a shortcut. Nothing is recorded while the flag is absent or older
-- than 15 minutes, and only the latest code is kept.
do
  local dir = os.getenv("XDG_RUNTIME_DIR") or "/tmp"
  local flag, out = dir .. "/omacheat-watch", dir .. "/omacheat-keys"
  local mod = { [37] = 1, [105] = 1, [50] = 1, [62] = 1, [64] = 1, [108] = 1, [133] = 1, [134] = 1, [66] = 1, [77] = 1, [92] = 1 }
  local seq = 0
  hl.on("input.keyboard.key", function(code, _, state)
    if type(code) ~= "number" or state ~= 1 or mod[code] then return end
    local f = io.open(flag, "r")
    if not f then return end
    local stamp = tonumber(f:read("*l") or "") or 0
    f:close()
    if os.time() - stamp > 900 then return end
    seq = seq + 1
    local w = io.open(out, "w")
    if w then w:write(os.time(), " ", seq, " ", code, "\n"); w:close() end
  end)
end
LUA
  } >"$generated.tmp" && mv "$generated.tmp" "$generated"
}

case "$1" in
  list) cat "$state" ;;
  set)
    mode="$2"; items="$3"
    if [[ $mode == off ]]; then
      jq --argjson new "$items" "$id_filter"' (. + $new) | unique_by(id)' "$state" >"$state.tmp"
    else
      jq --argjson gone "$items" "$id_filter"' ($gone | map(id)) as $ids | map(select(id as $i | $ids | index($i) | not))' "$state" >"$state.tmp"
    fi && mv "$state.tmp" "$state"
    generate
    hyprctl reload >/dev/null
    ;;
  settings) cat "$settings" ;;
  setting)   # setting <key> <true|false>
    jq --arg k "$2" --argjson v "$3" '.[$k] = $v' "$settings" >"$settings.tmp" && mv "$settings.tmp" "$settings" ;;
  custom) cat "$custom" ;;
  add|remove)
    id='def id: ((.mods | map(ascii_upcase) | sort | join(" ")) + "|" + (.key | ascii_upcase));'
    if [[ $1 == add ]]; then
      jq --argjson new "$2" "$id"' map(select(id as $i | ([$new] | map(id) | index($i)) | not)) + [$new]' "$custom" >"$custom.tmp"
    else
      jq --argjson gone "$2" "$id"' map(select(id as $i | ([$gone] | map(id) | index($i)) | not))' "$custom" >"$custom.tmp"
    fi && mv "$custom.tmp" "$custom"
    generate
    hyprctl reload >/dev/null
    ;;
  watch)
    if [[ $2 == on ]]; then date +%s >"$watch_flag"; : >"${watch_flag%-watch}-keys"
    else rm -f "$watch_flag" "${watch_flag%-watch}-keys"; fi ;;
  scan) scan_binds ;;
  apply) generate; hyprctl reload >/dev/null ;;
  *) echo "usage: omacheat-apply list | set off|on <json> | custom | add|remove <json> | watch on|off | apply" >&2; exit 1 ;;
esac
